Algoritmo AgroInsumosDelValle
    Definir opcion, stock, cantidad Como Entero
    Definir subtotal, descuento, total, recaudo Como Real
	
    Escribir "Ingrese stock inicial:"
    Leer stock
	
    Mientras stock <= 0 Hacer
        Escribir "El stock debe ser mayor que 0"
        Leer stock
    FinMientras
	
    recaudo <- 0
	
    Repetir
        Escribir "1. Realizar venta"
        Escribir "2. Consultar stock"
        Escribir "3. Cerrar caja"
        Leer opcion
		
        Segun opcion Hacer
            1:
                Escribir "Cantidad de sacos:"
                Leer cantidad
				
                Mientras cantidad <= 0 Hacer
                    Escribir "La cantidad debe ser mayor que 0"
                    Leer cantidad
                FinMientras
				
                Si cantidad > stock Entonces
                    Escribir "Stock insuficiente"
                SiNo
                    subtotal = cantidad * 85000
					
                    Si cantidad >= 10 Entonces
                        descuento = subtotal * 0.08
                    SiNo
                        descuento = 0
                    FinSi
					
                    total = subtotal - descuento
                    stock = stock - cantidad
                    recaudo = recaudo + total
					
                    Escribir "Total: ", total
                FinSi
				
            2:
                Escribir "Stock disponible: ", stock
				
            3:
                Escribir "Recaudo: ", recaudo
                Escribir "Stock final: ", stock
        FinSegun
    Hasta Que opcion = 3
FinAlgoritmo
