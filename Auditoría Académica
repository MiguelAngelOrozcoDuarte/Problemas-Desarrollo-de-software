Algoritmo AuditoriaAcademica
    Definir opcion Como Entero
    Definir nota1, nota2, nota3, definitiva, suma, promedio Como Real
    Definir aprobados, recuperacion, reprobados, total Como Entero
	
    aprobados = 0
    recuperacion = 0
    reprobados = 0
    total = 0
    suma = 0
	
    Repetir
        Escribir "1. Registrar estudiante"
        Escribir "2. Estadísticas"
        Escribir "3. Salir"
        Leer opcion
		
        Segun opcion Hacer
            1:
                Escribir "Nota 1:"
                Leer nota1
                Mientras nota1 < 0 O nota1 > 5 Hacer
                    Escribir "Nota inválida"
                    Leer nota1
                FinMientras
				
                Escribir "Nota 2:"
                Leer nota2
                Mientras nota2 < 0 O nota2 > 5 Hacer
                    Escribir "Nota inválida"
                    Leer nota2
                FinMientras
				
                Escribir "Nota 3:"
                Leer nota3
                Mientras nota3 < 0 O nota3 > 5 Hacer
                    Escribir "Nota inválida"
                    Leer nota3
                FinMientras
				
                definitiva = nota1*0.30 + nota2*0.30 + nota3*0.40
                total = total + 1
                suma = suma + definitiva
				
                Si definitiva >= 3 Entonces
                    aprobados = aprobados + 1
                    Escribir "Aprobado"
                SiNo
                    Si definitiva >= 2 Entonces
                        recuperacion = recuperacion + 1
                        Escribir "Recuperación"
                    SiNo
                        reprobados = reprobados + 1
                        Escribir "Reprobado"
                    FinSi
                FinSi
				
            2:
                Si total > 0 Entonces
                    promedio = suma / total
                    Escribir "Total: ", total
                    Escribir "Aprobados: ", aprobados
                    Escribir "Recuperación: ", recuperacion
                    Escribir "Reprobados: ", reprobados
                    Escribir "Promedio: ", promedio
                FinSi
        FinSegun
    Hasta Que opcion = 3
FinAlgoritmo
